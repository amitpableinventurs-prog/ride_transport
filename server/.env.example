PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rideflow_admin
CORS_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

SEED_ADMIN_PASSWORD=Admin@123

# Mobile app (customer / rider-driver / partner) tokens. Default to the admin
# secrets with an ":app" suffix; set explicitly in production.
JWT_APP_ACCESS_SECRET=change-me-app-access-secret
JWT_APP_REFRESH_SECRET=change-me-app-refresh-secret
APP_ACCESS_TOKEN_TTL_MINUTES=60
APP_REFRESH_TOKEN_TTL_DAYS=30

# OTP (admin login second step + mobile app phone login).
# OTP validity is set in the admin panel: Settings > Security > OTP expiry.
OTP_SECRET=change-me-otp-secret
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# console = print OTP SMS to the server log (development). Add real providers in src/utils/sms.ts.
SMS_PROVIDER=console
# Return the OTP in API responses as devOtp for testing. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=true

# Base URL the apps use to reach this API (share-tracking and invoice links).
PUBLIC_BASE_URL=http://localhost:5000
# Uploaded documents and photos (default: ./uploads, served at /uploads).
# UPLOAD_DIR=

# Payments: mock (development; verify with signature "mock_success") or razorpay.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Push notifications: console prints them. Masked calls: direct returns the real number (development only).
PUSH_PROVIDER=console
TELEPHONY_PROVIDER=direct

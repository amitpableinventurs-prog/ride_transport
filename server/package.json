{
  "name": "rider-transport-admin-api",
  "version": "1.0.0",
  "private": true,
  "description": "Admin REST API for the Rider & Transport Platform (Phase 1: Auth, RBAC, Dashboard, Settings)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",

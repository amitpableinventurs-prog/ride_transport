    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
